{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qnet.local/schemas/bar-bounds-input-v1.json",
  "title": "Qnet orthant SRBM BAR moment bounds input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_type",
    "drift",
    "covariance",
    "reflection"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "model_type": {
      "const": "orthant_srbm_bar_bounds"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "drift": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "covariance": {
      "$ref": "#/$defs/squareMatrix"
    },
    "reflection": {
      "$ref": "#/$defs/squareMatrix"
    },
    "relaxation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 2
        },
        "max_variables": {
          "type": "integer",
          "minimum": 1,
          "default": 100000
        },
        "max_psd_entries": {
          "type": "integer",
          "minimum": 1,
          "default": 5000000
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "moment"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "moment": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "squareMatrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "number"
        }
      }
    }
  },
  "$comment": "The program additionally enforces matching dimensions, symmetry/positive definiteness, nonsingular-M-matrix reflection, strict stability, and target degree <= 2*order. Reflection direction i is column i."
}
