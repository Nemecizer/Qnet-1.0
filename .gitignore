# ── Research artifacts (private, per user) ────────────────
experiment/
.testcases/

# ── Large regeneratable benchmark working data ────────────
# 126MB of dense .qna inputs — exceeds GitHub's per-file cap.
# Regenerate with the scripts in validation/algo_review/.
validation/algo_review/work/
validation/feedback_runs/

# ── Icon reference renders ────────────────────────────────
# `assets/make_icon.sh` writes the one shipping artefact, AppIcon.icns,
# which is committed. With `--reference` it also renders the dark and
# tinted variants and the appiconset that describes all three for a
# future asset-catalog build; nothing in the product reads those, so they
# stay local (1.2 MB of binaries that churned on every motif tweak).
assets/AppIcon.appiconset/
assets/AppIcon-dark.icns
assets/AppIcon-tinted.icns

# ── Literature PDFs (copyright; keep local) ───────────────
# Same rule the solver-directory PDFs above already follow: the 52 published
# papers in Papers/ are third-party copyrighted work and 33 MB of binaries that
# would be in every clone forever. The project's OWN writing about them —
# the survey, the index, the manifest and the bibliography — stays tracked.
Papers/*.pdf
